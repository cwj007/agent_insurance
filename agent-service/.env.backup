# ============================================================
# 保险 Agent 服务环境变量模板
# 复制为 .env 后填写密钥；请勿把真实密钥写回本文件
# 布尔值使用 true/false；时间单位见各项说明
# ============================================================

# ==================== 应用配置 ====================
# 应用名称；用于 FastAPI 文档标题和启动日志。
APP_NAME=安心保
# 应用版本号；显示在 OpenAPI 文档中。
APP_VERSION=1.0.0
# 监听地址；0.0.0.0 允许外部访问，127.0.0.1 仅本机可访问。
APP_HOST=0.0.0.0
# 监听端口，默认 8001。
APP_PORT=8001
# 是否开启 FastAPI 调试模式；生产环境建议 false。
APP_DEBUG=true

# ==================== 日志配置 ====================
# 日志级别：DEBUG / INFO / WARNING / ERROR；生产环境建议 INFO。
LOGGING_LEVEL=DEBUG

# ==================== PostgreSQL 数据库 ====================
# 数据库主机；本地 docker compose 通常为 127.0.0.1。
DB_HOST=你的数据库地址
# 数据库端口，默认 5432。
DB_PORT=5432
# 数据库名称。
DB_NAME=insurance
# 数据库用户名。
DB_USER=insurance
# 数据库密码；docker compose 开发默认值为 insurance123，生产环境务必修改。
DB_PASSWORD=insurance123
# 是否打印 SQL 语句；排查问题时设为 true。
DB_ECHO=false
# 连接池常驻连接数。
DB_POOL_SIZE=5
# 连接池允许的额外连接数。
DB_MAX_OVERFLOW=10
# 获取连接的最长等待秒数。
DB_POOL_TIMEOUT=30
# 取连接前先探测，避免使用已失效的连接。
DB_POOL_PRE_PING=true
# 连接回收秒数，防止被数据库主动断开。
DB_POOL_RECYCLE=1800

# ==================== Ollama 本地模型 ====================
# 本地 Ollama 服务地址；意图分类、L1 语义路由和 RAG 嵌入共用。
OLLAMA_BASE_URL=http://127.0.0.1:11434
# L2 意图分类使用的本地 Ollama 模型。
INTENT_MODEL_NAME=qwen3.5:0.8b
# RAG 与 L1 语义路由使用的 Ollama 嵌入模型。
EMBEDDING_MODEL_NAME=qwen3-embedding:0.6b
# 嵌入向量维度；修改后必须与 Milvus collection 中的向量维度一致。
EMBEDDING_DIMENSIONS=1024

# ==================== DeepSeek 主模型 ====================
# DeepSeek API Key，必填。
DEEPSEEK_API_KEY=
# 主聊天模型名称，默认 deepseek-v4-flash。
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash

# ==================== DashScope：兜底 / 嵌入 / 重排 ====================
# DashScope API Key；留空时不启用兜底模型。
DASHSCOPE_API_KEY=
# 旧配置项，当前代码未读取；保留以兼容历史配置，可删除。
# DASHSCOPE_BASE_URL=
# 主模型故障时的兜底聊天模型；配置类要求必填，即使不启用兜底也需保留。
DASHSCOPE_CHAT_MODEL=qwen4-max
# 预留的 DashScope 嵌入模型名；当前 RAG 实际使用 Ollama，此项不生效。
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
# 预留的 DashScope 重排模型名；当前重排模型在 app/rag/retriever.py 中固定为 gte-rerank-v2，此项不生效。
DASHSCOPE_RERANK_MODEL=qwen3.7-text-rerank

# ==================== 模型可靠性 ====================
# 主模型通用重试次数（含首次调用）；写操作建议至少 2。
LLM_RETRY_ATTEMPTS=2
# 主模型重试退避基数（秒），按尝试次数线性增长。
LLM_RETRY_BACKOFF_SECONDS=0.3
# 主模型连续失败多少次后触发熔断。
LLM_BREAKER_FAILURES=3
# 熔断后的冷却时间（秒）；冷却结束会自动重试主模型。
LLM_BREAKER_COOLDOWN_SECONDS=60

# ==================== MinerU：条款 PDF 解析 ====================
# MinerU API Key；运行 scripts/ingest_rag.py 构建条款知识库时需要。
MINERU_API_KEY=

# ==================== Milvus / RAG ====================
# Milvus 地址；本地 docker compose 通常为 127.0.0.1。
MILVUS_HOST=你的Milvus地址
# Milvus 端口，默认 19530。
MILVUS_PORT=19530
# Milvus collection 名称；入库与检索必须使用同一个 collection。
MILVUS_COLLECTION_NAME=insurance_collection
# 是否启用 DashScope 重排；true 召回更全但延迟更高，重排服务故障时可设为 false。
RAG_ENABLE_RERANK=true

# ==================== 工具调用 ====================
# 单次工具执行超时秒数；超时会转为可重试错误。
TOOL_TIMEOUT_SECONDS=10
# 单次运行的工具调用总上限，防止模型死循环。
TOOL_GLOBAL_RUN_LIMIT=10
# 单次运行中单个工具的调用上限。
TOOL_PER_TOOL_RUN_LIMIT=3
# 工具瞬时异常的重试次数；只重试 ToolTransientError。
TOOL_MAX_RETRIES=2
# 工具重试初始退避秒数。
TOOL_RETRY_INITIAL_DELAY=0.3
# 工具重试最大退避秒数。
TOOL_RETRY_MAX_DELAY=2.0

# ==================== 上下文治理 ====================
# 主图历史消息超过该数量时触发摘要。
SUMMARY_TRIGGER_MESSAGES=40
# 主图摘要后保留的最近消息条数。
SUMMARY_KEEP_MESSAGES=12
# 子 Agent 历史消息超过该数量时触发摘要。
SUBAGENT_SUMMARY_TRIGGER_MESSAGES=60
# 子 Agent 摘要后保留的最近消息条数。
SUBAGENT_SUMMARY_KEEP_MESSAGES=12

# ==================== 安全校验 ====================
# 用户输入最大字符数，超长输入直接拒绝。
MAX_INPUT_LENGTH=4000
# 输入校验模型故障时是否放行；true 保可用，false 一律拦截。
INPUT_GUARD_FAIL_OPEN=true
# 输出校验模型故障时是否放行；默认 false，保合规。
OUTPUT_GUARD_FAIL_OPEN=false

# ==================== 流式输出 ====================
# SSE 回答分片字符数；越小越接近逐字输出。
STREAM_CHUNK_SIZE=2
# 每个 SSE 分片之间的间隔秒数。
STREAM_CHUNK_DELAY_SECONDS=0.025
# 单轮回答分片推送的总延迟上限秒数。
STREAM_MAX_TOTAL_DELAY_SECONDS=2.5

# ==================== Agent 流程 ====================
# 连续澄清最大轮数，超过后进入兜底，避免死循环。
MAX_CLARIFICATION_ROUNDS=2
# 是否把输入安全校验与 L2 意图分类合并为一次模型调用。
ENABLE_COMBINED_INPUT_ANALYSIS=true

# ==================== Agent 运行 ====================
# checkpoint 持久化强度：sync（每步同步落盘）/ async（异步落盘）/ exit（退出时落盘）；写操作建议 sync。
AGENT_RUN_DURABILITY=sync
# 是否在输出合规校验前流式推送回答；false 表示先审核再推送，更安全。
STREAM_BEFORE_OUTPUT_GUARD=false
# 运行心跳写入间隔，单位秒。
AGENT_RUN_HEARTBEAT_INTERVAL_SECONDS=10
# 心跳超过该秒数视为 worker 失联，由其他实例接管或标记失败。
AGENT_RUN_STALE_SECONDS=60
# 跨 worker 取消请求的轮询间隔，单位秒。
AGENT_RUN_CANCEL_POLL_INTERVAL_SECONDS=2

# ==================== 数据保留 ====================
# 运行事件保留天数。
RUN_EVENT_RETENTION_DAYS=30
# 工具调用记录保留天数。
TOOL_INVOCATION_RETENTION_DAYS=30
# Agent 运行主记录保留天数。
AGENT_RUN_RETENTION_DAYS=90
# 用户情节记忆保留天数。
USER_MEMORY_RETENTION_DAYS=180
# 过期数据清理任务运行间隔，单位小时。
RETENTION_CLEANUP_INTERVAL_HOURS=24

# ==================== 测试（可选，仅集成测试使用） ====================
# 设为 1 时启用需要真实 Ollama / Postgres / Milvus / DeepSeek 的集成测试；正常运行无需设置。
# RUN_AGENT_INTEGRATION=1
