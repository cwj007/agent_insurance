digraph LangGraph {
    graph [
        rankdir=TB,
        bgcolor="#FFFFFF",
        fontname="Microsoft YaHei",
        fontsize=22,
        labelloc=t,
        label="保险顾问主 Graph（LangGraph draw_mermaid 生成）\n虚线 = Command 动态跳转",
        nodesep=0.55,
        ranksep=0.70,
        pad=0.35,
        splines=true
    ];
    node [
        fontname="Microsoft YaHei",
        fontsize=14,
        shape=box,
        style="rounded,filled",
        color="#64748B",
        penwidth=1.5,
        margin="0.20,0.12",
        fillcolor="#DCFCE7"
    ];
    edge [
        fontname="Microsoft YaHei",
        fontsize=11,
        color="#64748B",
        arrowsize=0.8,
        penwidth=1.3
    ];

    "__start__" [label="START",shape=circle,style=filled,fillcolor="#0F172A",fontcolor="white",width=0.75,fixedsize=true];
    "prepare_context" [label="prepare_context\n上下文摘要",fillcolor="#E0F2FE",color="#0284C7"];
    "input_guard" [label="input_guard\n输入安全校验 + 合并意图分析",shape=diamond,style=filled,fillcolor="#FEF3C7",color="#D97706"];
    "guard_reply" [label="guard_reply\n固定拦截话术",fillcolor="#FEE2E2",color="#DC2626"];
    "route" [label="route\n意图路由",shape=diamond,style=filled,fillcolor="#FEF3C7",color="#D97706"];
    "clarify_node" [label="clarify_node\n澄清追问",fillcolor="#EDE9FE",color="#7C3AED"];
    "recommendation_node" [label="recommendation_node\n推荐子 Agent"];
    "claim_node" [label="claim_node\n理赔子 Agent"];
    "chitchat_node" [label="chitchat_node\n闲聊"];
    "human_handoff_node" [label="human_handoff_node\n转人工"];
    "fallback_node" [label="fallback_node\n兜底选项"];
    "output_guard" [label="output_guard\n输出合规校验",fillcolor="#FFEDD5",color="#EA580C"];
    "__end__" [label="END",shape=circle,style=filled,fillcolor="#0F172A",fontcolor="white",width=0.75,fixedsize=true];

    "__start__" -> "prepare_context";
    "chitchat_node" -> "output_guard";
    "claim_node" -> "output_guard";
    "clarify_node" -> "output_guard";
    "fallback_node" -> "output_guard";
    "human_handoff_node" -> "output_guard";
    "input_guard" -> "guard_reply" [label="拦截", style=dotted, color="#7C3AED", fontcolor="#7C3AED", color="#DC2626", fontcolor="#DC2626"];
    "input_guard" -> "route" [label="放行", style=dotted, color="#7C3AED", fontcolor="#7C3AED", color="#16A34A", fontcolor="#16A34A"];
    "prepare_context" -> "input_guard";
    "recommendation_node" -> "output_guard";
    "route" -> "chitchat_node" [label="chitchat", style=dotted, color="#7C3AED", fontcolor="#7C3AED"];
    "route" -> "claim_node" [label="claim", style=dotted, color="#7C3AED", fontcolor="#7C3AED"];
    "route" -> "clarify_node" [label="低置信度", style=dotted, color="#7C3AED", fontcolor="#7C3AED"];
    "route" -> "fallback_node" [label="fallback / 超限", style=dotted, color="#7C3AED", fontcolor="#7C3AED"];
    "route" -> "human_handoff_node" [label="human_handoff", style=dotted, color="#7C3AED", fontcolor="#7C3AED"];
    "route" -> "recommendation_node" [label="recommendation_plan", style=dotted, color="#7C3AED", fontcolor="#7C3AED"];
    "guard_reply" -> "__end__";
    "output_guard" -> "__end__";
}