digraph LangGraph {
    graph [
        rankdir=TB,
        bgcolor="#FFFFFF",
        fontname="Microsoft YaHei",
        fontsize=22,
        labelloc=t,
        label="保险顾问主 Graph（LangGraph）",
        nodesep=0.55,
        ranksep=0.70,
        pad=0.35,
        splines=true
    ];

    node [
        fontname="Microsoft YaHei",
        fontsize=14,
        shape=box,
        style="rounded,filled",
        color="#64748B",
        penwidth=1.5,
        margin="0.20,0.12"
    ];

    edge [
        fontname="Microsoft YaHei",
        fontsize=11,
        color="#64748B",
        arrowsize=0.8,
        penwidth=1.3
    ];

    start [
        label="START",
        shape=circle,
        style="filled",
        fillcolor="#0F172A",
        fontcolor="white",
        width=0.75,
        fixedsize=true
    ];

    prepare [
        label="prepare_context\n上下文摘要",
        fillcolor="#E0F2FE",
        color="#0284C7"
    ];

    input_guard [
        label="input_guard\n输入安全校验\n+ 合并意图分析",
        shape=diamond,
        style="filled",
        fillcolor="#FEF3C7",
        color="#D97706",
        margin="0.06,0.04"
    ];

    guard_reply [
        label="guard_reply\n固定拦截话术",
        fillcolor="#FEE2E2",
        color="#DC2626"
    ];

    route [
        label="route\n意图路由",
        shape=diamond,
        style="filled",
        fillcolor="#FEF3C7",
        color="#D97706",
        margin="0.06,0.04"
    ];

    subgraph cluster_workflows {
        label="工作流节点";
        labeljust="l";
        labelloc="t";
        fontsize=13;
        fontcolor="#475569";
        style="rounded,dashed";
        color="#CBD5E1";
        margin=14;

        node [fillcolor="#DCFCE7", color="#16A34A"];

        handoff [label="human_handoff_node\n转人工"];
        recommend [label="recommendation_node\n推荐子 Agent"];
        claim [label="claim_node\n理赔子 Agent"];
        chitchat [label="chitchat_node\n闲聊"];
        fallback [label="fallback_node\n兜底选项"];
        clarify [
            label="clarify_node\n澄清追问",
            fillcolor="#EDE9FE",
            color="#7C3AED"
        ];
    }

    output_guard [
        label="output_guard\n输出合规校验",
        fillcolor="#FFEDD5",
        color="#EA580C"
    ];

    end [
        label="END",
        shape=circle,
        style="filled",
        fillcolor="#0F172A",
        fontcolor="white",
        width=0.75,
        fixedsize=true
    ];

    start -> prepare;
    prepare -> input_guard;

    input_guard -> guard_reply [
        label="拦截",
        color="#DC2626",
        fontcolor="#DC2626"
    ];
    guard_reply -> end;

    input_guard -> route [
        label="放行",
        color="#16A34A",
        fontcolor="#16A34A"
    ];

    route -> handoff [label="human_handoff"];
    route -> recommend [label="recommendation"];
    route -> claim [label="claim"];
    route -> chitchat [label="chitchat"];
    route -> fallback [label="fallback / 超限"];
    route -> clarify [
        label="低置信度",
        color="#7C3AED",
        fontcolor="#7C3AED"
    ];

    handoff -> output_guard;
    recommend -> output_guard;
    claim -> output_guard;
    chitchat -> output_guard;
    fallback -> output_guard;
    clarify -> output_guard;

    output_guard -> end;
}
